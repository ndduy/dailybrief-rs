# Copy to .env (gitignored). Mint the token on the host with `claude setup-token`
# (one-year OAuth token, billed to the Claude subscription). Only the app service requires it.
# Never put ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here: they outrank the subscription (SPEC.md §2).
CLAUDE_CODE_OAUTH_TOKEN=
# Cloudflare Access (SPEC.md §7 Auth): the Access application's AUD tag and your team name.
CF_ACCESS_AUD=
CF_ACCESS_TEAM=
