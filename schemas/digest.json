{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "beyondRadar": {
      "description": "Number of beyond_radar items published",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "date": {
      "description": "Digest date, YYYY-MM-DD, as returned by publish_digest",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
    },
    "digestId": {
      "description": "The id returned by publish_digest",
      "minLength": 1,
      "type": "string"
    },
    "forYou": {
      "description": "Number of for_you items published",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "notes": {
      "description": "Optional one-line note for the human reader (≤ 300 chars)",
      "maxLength": 300,
      "type": "string"
    }
  },
  "required": [
    "digestId",
    "date",
    "forYou",
    "beyondRadar"
  ],
  "title": "DigestOutput",
  "type": "object"
}
