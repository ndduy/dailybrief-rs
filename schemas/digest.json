{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "digestId": {
      "type": "string",
      "minLength": 1,
      "description": "The id returned by publish_digest"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Digest date, YYYY-MM-DD, as returned by publish_digest"
    },
    "forYou": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Number of for_you items published"
    },
    "beyondRadar": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Number of beyond_radar items published"
    },
    "notes": {
      "description": "Optional one-line note for the human reader (≤ 300 chars)",
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "digestId",
    "date",
    "forYou",
    "beyondRadar"
  ],
  "additionalProperties": false
}
